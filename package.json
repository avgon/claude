{
  "name": "claude-stagehand-browser-skill",
  "version": "1.0.0",
  "description": "AI browser automation skill for Claude Code using Stagehand",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "browser": "./src/cli.js"
  },
  "scripts": {
    "browse": "node src/browser-agent.js",
    "cli": "node src/cli.js",
    "install:deps": "npm install",
    "example:complete": "node src/examples/complete-automation-example.js complete",
    "example:research": "node src/examples/complete-automation-example.js research",
    "example:n8n": "node src/examples/automation-flows.js",
    "search": "node src/integrations/tavily-search.js",
    "tokenize": "node src/integrations/token-efficiency.js"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^2.0.0",
    "gpt-tokenizer": "^2.4.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "browser-automation",
    "ai",
    "stagehand",
    "playwright",
    "automation",
    "n8n",
    "make",
    "weavy",
    "claude-code",
    "agent-browse",
    "cli"
  ],
  "author": "Claude Code",
  "license": "MIT"
}
